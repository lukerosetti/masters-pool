{
  "rules": {
    ".read": false,
    ".write": false,
    "golf-pools": {
      ".read": false,
      ".write": false,
      "$poolId": {
        ".read": "$poolId.matches(/^[A-Z0-9]{5}$/)",
        ".write": "$poolId.matches(/^[A-Z0-9]{5}$/)",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "createdAt": { ".validate": "newData.isNumber()" },
        "deadline": { ".validate": "newData.isNumber()" },
        "locked": { ".validate": "newData.isBoolean()" },
        "lockedAt": { ".validate": "newData.isNumber()" },
        "players": {
          "$playerId": {
            ".validate": "$playerId.matches(/^player_[0-9]+$/)",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
            },
            "picks": {
              "$index": {
                ".validate": "$index.matches(/^[0-5]$/) && newData.isString() && newData.val().length <= 80"
              }
            },
            "locked": { ".validate": "newData.isBoolean()" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "submittedAt": { ".validate": "newData.isNumber()" },
            "isCommissioner": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
